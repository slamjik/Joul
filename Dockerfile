# ==============================================================================
# КафИС — Автономный Production Dockerfile (Node.js 20 Alpine)
# Полная автоматическая сборка фронтенда и запуск сервера с автоуправлением ОЗУ
# ==============================================================================
FROM node:20-alpine

WORKDIR /app

# Копируем манифесты зависимостей
COPY package.json ./

# Устанавливаем все зависимости
RUN npm install --legacy-peer-deps

# Копируем исходный код проекта
COPY . .

# Собираем оптимизированный production-бандл фронтенда (в папку /app/dist)
RUN npm run build

# Создаем директорию для постоянного хранения БД и резервных копий
RUN mkdir -p /app/server/data/backups

# Открываем порт 3000 для локальной сети
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

# Запускаем сервер с поддержкой принудительной сборки мусора (--expose-gc) и лимитом ОЗУ
CMD ["node", "--expose-gc", "--max-old-space-size=2048", "server.js"]
